{
  "name": "tao-price-dashboard-takehome",
  "version": "1.0.0",
  "private": true,
  "description": "Frontend take-home exercise scaffold for a TAO token exchange web app.",
  "scripts": {
    "backend:dev": "pnpm --filter @tao-takehome/backend dev",
    "backend:build": "pnpm --filter @tao-takehome/backend build",
    "backend:start": "pnpm --filter @tao-takehome/backend start",
    "backend:test": "pnpm --filter @tao-takehome/backend test",
    "backend:typecheck": "pnpm --filter @tao-takehome/backend typecheck",
    "web:dev": "pnpm --filter @tao-takehome/web-starter dev",
    "web:build": "pnpm --filter @tao-takehome/web-starter build",
    "web:start": "pnpm --filter @tao-takehome/web-starter start",
    "web:lint": "pnpm --filter @tao-takehome/web-starter lint",
    "web:lint:fix": "pnpm --filter @tao-takehome/web-starter lint:fix",
    "web:format": "pnpm --filter @tao-takehome/web-starter format",
    "web:format:check": "pnpm --filter @tao-takehome/web-starter format:check",
    "web:typecheck": "pnpm --filter @tao-takehome/web-starter typecheck",
    "web:test": "pnpm --filter @tao-takehome/web-starter test",
    "web:e2e": "pnpm --filter @tao-takehome/web-starter e2e"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
